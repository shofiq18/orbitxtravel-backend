NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/orbitxtravel?retryWrites=true&w=majority

JWT_SECRET=super_secret_key_orbitx_travel_backend_2026
JWT_EXPIRES_IN=30d

# Email settings (Nodemailer / Resend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary Storage Settings
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMS Gateway Settings (Greenweb / BulkSMSBD)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id

# Business Configuration
PLATFORM_COMMISSION_RATE=0.10
OTP_EXPIRY_MINUTES=10


BKASH_PAYOUT_MODE=live
BKASH_APP_KEY=your_real_app_key
BKASH_APP_SECRET=your_real_app_secret
BKASH_USER=your_real_username
BKASH_PASSWORD=your_real_password

